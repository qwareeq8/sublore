{
  "manifest_version": 3,
  "name": "Sublore",
  "version": "2.0.0",
  "description": "Shows how active Reddit commenters are in subreddits you choose, right beside their username.",
  "homepage_url": "https://github.com/qwareeq8/sublore",
  "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"},
  "permissions": ["storage"],
  "host_permissions": ["https://arctic-shift.photon-reddit.com/*"],
  "background": {
    "scripts": ["src/platform.js", "src/settings.js", "src/api.js", "src/cache.js", "src/scheduler.js", "src/background.js"]
  },
  "content_scripts": [{
    "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://new.reddit.com/*", "https://reddit.com/*"],
    "js": ["src/platform.js", "src/settings.js", "src/discovery.js", "src/render.js", "src/content.js"],
    "css": ["src/styles.css"],
    "run_at": "document_idle"
  }],
  "options_ui": {"page": "options/options.html", "open_in_tab": true},
  "action": {
    "default_title": "Sublore settings",
    "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sublore@qwareeq.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["websiteContent"]}
    }
  }
}
